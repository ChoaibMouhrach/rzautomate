---
import { Logo } from "@/components/site/logo";
import { NewsletterForm } from "@/components/site/newsletter-form";
import { ThemeSwitcher } from "@/components/site/theme-switcher";
import { legalNav } from "@/lib/site";
import { footer } from "@/lib/footer";
---

<footer class="relative mt-auto overflow-hidden bg-ink text-paper">
  <div class="page-container relative z-10 grid grid-cols-1 gap-16 pb-12 pt-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="flex min-w-0 flex-col gap-8">
      <div>
        <Logo className="h-8 fill-paper" />
        <p class="mt-6 max-w-md text-paper/70">{footer.tagline}</p>
      </div>
      <div class="rounded-3xl bg-paper p-6 text-ink [--foreground:#171717] [--muted-foreground:#5c5f66] [--muted:#f4f4f5]">
        <p class="text-sm font-medium text-muted-foreground">
          {footer.newsletterLabel}
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight">
          {footer.newsletterHeading}
        </h2>
        <div class="mt-5">
          <NewsletterForm client:visible />
        </div>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 text-sm sm:grid-cols-3">
      {
        footer.columns.map((column) => (
          <nav aria-label={column.title} class="flex flex-col items-start gap-3">
            <h2 class="mb-1 text-base font-semibold">{column.title}</h2>
            {column.links.map((link) => (
              <a
                href={link.href}
                class="text-paper/60 transition-colors hover:text-paper"
              >
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>
  <div class="page-container relative z-10 flex flex-col gap-4 pb-10 text-sm text-paper/60 sm:flex-row sm:items-center sm:justify-between">
    <p>{footer.entity} · © {new Date().getFullYear()}</p>
    <div class="flex items-center gap-6">
    <nav aria-label="Legal" class="flex gap-6">
      {
        legalNav.map((item) => (
          <a href={item.href} class="transition-colors hover:text-paper">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="[&_button]:bg-white/10 [&_button]:text-paper">
      <ThemeSwitcher client:visible />
    </div>
    </div>
  </div>
</footer>
