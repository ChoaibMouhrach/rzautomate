---
import type { GetStaticPaths } from "astro";
import { ModelCalculator } from "@/components/pages/models/[slug]/calculator";
import { ModelCta } from "@/components/pages/models/[slug]/cta";
import { getModelPage, modelPages } from "@/components/pages/models/[slug]";
import { ModelJsonLd } from "@/components/pages/models/[slug]/json-ld";
import { AccessSection, CalculatorSection, CompareSection, FitSection, FreeSection, ModelFaq, ModelHero, PricingSection, RelatedSection, VersionsSection } from "@/components/pages/models/[slug]/sections";
import { SpecsSection } from "@/components/pages/models/[slug]/specs";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { pageSocial } from "@/lib/metadata";
import { getModel } from "@/lib/models";

export const getStaticPaths = (() =>
  modelPages.map((page) => ({
    params: { slug: page.slug },
    props: { slug: page.slug },
  }))) satisfies GetStaticPaths;

const { slug } = Astro.props;
const page = getModelPage(slug)!;
const { name, provider } = getModel(slug)!;
const seo = pageSocial({ title: page.title, description: page.description });
---

<SiteLayout {...seo}>
  <ModelJsonLd page={page} name={name} provider={provider} />
  <ModelHero page={page} provider={provider} />
  <PricingSection page={page} name={name} />
  <CalculatorSection name={name} intro={page.calc.intro}>
    <ModelCalculator client:visible slug={slug} calc={page.calc} />
  </CalculatorSection>
  <SpecsSection client:visible name={name} rows={page.specs} />
  <AccessSection page={page} name={name} />
  <FreeSection page={page} name={name} />
  <CompareSection page={page} name={name} />
  <FitSection page={page} name={name} />
  <VersionsSection page={page} />
  <ModelFaq page={page} name={name} />
  <ModelCta client:visible slug={slug} cta={page.cta} />
  <RelatedSection page={page} />
</SiteLayout>
