---
import { ModelsDirectory } from "@/components/pages/models/models-directory";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { pageSocial } from "@/lib/metadata";
import { models } from "@/lib/models";

const seo = pageSocial({
  title: "Compare AI Models: API Pricing & Context Windows",
  description: `Compare ${models.length} AI models from OpenAI and Anthropic. API prices per 1M tokens, context windows and features. Manually checked; last updated Nov 1, 2026.`,
});
---

<SiteLayout {...seo}>
  <ModelsDirectory client:load />
</SiteLayout>
