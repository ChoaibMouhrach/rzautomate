---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { Page, PageContent } from "@/components/site/page";
import { ContactHeader } from "@/components/pages/contact/contact-header";
import { ContactJsonLd } from "@/components/pages/contact/contact-json-ld";
import { ContactOptions } from "@/components/pages/contact/contact-options";
import { pageSocial } from "@/lib/metadata";
import { pageMetadata } from "@/lib/pages";
---

<SiteLayout {...pageSocial(pageMetadata.contact)}>
  <Page>
    <ContactJsonLd />
    <ContactHeader />
    <PageContent>
      <ContactOptions client:load />
    </PageContent>
  </Page>
</SiteLayout>
