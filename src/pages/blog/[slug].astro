---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import PostBody from "@/components/pages/blog/[slug]/post-body.astro";
import { PostCover } from "@/components/pages/blog/[slug]/post-cover";
import { PostHeader } from "@/components/pages/blog/[slug]/post-header";
import { PostJsonLd } from "@/components/pages/blog/[slug]/post-json-ld";
import { PostReadingProgress } from "@/components/pages/blog/[slug]/post-reading-progress";
import { PostSidebar } from "@/components/pages/blog/[slug]/post-sidebar";
import { getPosts, isoDate, lastModified, postPath } from "@/lib/blog";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { authors } from "@/lib/authors";
import { pageSocial } from "@/lib/metadata";

export const getStaticPaths = (async () =>
  (await getPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const seo = pageSocial({
  title: post.data.metaTitle ?? post.data.title,
  description: post.data.excerpt,
  image: {
    url: `${postPath(post)}/opengraph-image.png`,
    alt: post.data.title,
  },
  authors: [authors[post.data.author].name],
  article: {
    publishedTime: isoDate(post.data.date),
    modifiedTime: lastModified(post),
  },
});
---

<SiteLayout {...seo}>
  <PostReadingProgress client:load targetId="post-article" />
  <article id="post-article" class="page-container pb-24 pt-10 sm:pt-16">
    <PostJsonLd post={post} />
    <PostHeader post={post} />
    <PostCover post={post} />
    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <div>
        <PostBody><Content /></PostBody>
      </div>
      <PostSidebar client:visible headings={headings} />
    </div>
  </article>
</SiteLayout>
