---
import "@fontsource-variable/geist";
import "@/styles/globals.css";
import BaseHead from "@/layouts/BaseHead.astro";
import { BackToTop } from "@/components/site/back-to-top";
import { JsonLd } from "@/components/site/json-ld";
import { siteJsonLd } from "@/lib/json-ld";
import type { PageSeo } from "@/lib/metadata";

type Props = PageSeo;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <BaseHead {...Astro.props} />
    <script is:inline>
      (() => {
        const query = matchMedia("(prefers-color-scheme: dark)");
        const apply = (root) => {
          let theme = "system";
          try {
            theme = localStorage.getItem("theme");
          } catch {}
          root.classList.toggle(
            "dark",
            theme === "dark" || (theme !== "light" && query.matches),
          );
        };
        apply(document.documentElement);
        query.addEventListener("change", () => apply(document.documentElement));
        document.addEventListener("astro:before-swap", (event) =>
          apply(event.newDocument.documentElement),
        );
      })();
    </script>
  </head>
  <body class="min-h-full flex flex-col" transition:animate="none">
    <JsonLd data={siteJsonLd()} />
    <slot />
    <BackToTop client:idle transition:persist="back-to-top" />
    <script>
      import "@/scripts/progress-bar";
    </script>
  </body>
</html>
