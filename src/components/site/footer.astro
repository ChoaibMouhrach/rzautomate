---
import { NewsletterForm } from "@/components/site/newsletter-form";
import { Logo } from "@/components/site/logo";
import { Link } from "@/components/ui/link";
import { services } from "@/lib/services";
import { legalNav, nav, site } from "@/lib/site";
---

<footer class="mt-auto border-t border-border">
      <div class="border-b border-border">
        <div class="page-container flex flex-col gap-6 py-12 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
          <div class="max-w-md">
            <h2 class="text-lg font-semibold tracking-tight">
              Subscribe to our newsletter
            </h2>
            <p class="mt-2 text-sm text-muted-foreground">
              Practical AI automation ideas and case studies, delivered to your
              inbox. No spam.
            </p>
          </div>
          <div class="w-full lg:max-w-md">
            <NewsletterForm client:visible />
          </div>
        </div>
      </div>
      <div class="page-container flex flex-col gap-8 py-12 lg:flex-row lg:justify-between">
        <div class="max-w-xs">
          <Logo className="h-7" />
          <p class="mt-2 text-sm text-muted-foreground">
            {site.description}
          </p>
        </div>
        <div class="grid gap-8 text-sm sm:grid-cols-2 xl:grid-cols-[minmax(0,20rem)_auto_auto_auto] sm:gap-12">
          <nav aria-label="Services" class="flex flex-col gap-2">
            <h2 class="mb-2 font-semibold">Services</h2>
            <Link href="/services" variant="muted">
              All services
            </Link>
            {services.map((service) => (
              <Link
                href={`/services/${service.slug}`}
                variant="muted"
              >
                {service.title}
              </Link>
))}
          </nav>
          <nav aria-label="Company" class="flex flex-col gap-2">
            <h2 class="mb-2 font-semibold">Company</h2>
            {nav
              .filter((item) => item.href !== "/services")
              .map((item) => (
                <Link href={item.href} variant="muted">
                  {item.label}
                </Link>
              ))}
          </nav>
          <nav aria-label="Directories" class="flex flex-col gap-2">
            <h2 class="mb-2 font-semibold">Directories</h2>
            <Link href="/models" variant="muted">
              Compare model prices
            </Link>
          </nav>
          <nav aria-label="Legal" class="flex flex-col gap-2">
            <h2 class="mb-2 font-semibold">Legal</h2>
            {legalNav.map((item) => (
              <Link href={item.href} variant="muted">
                {item.label}
              </Link>
            ))}
          </nav>
        </div>
      </div>
      <div class="page-container pb-8 text-sm text-muted-foreground">
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </div>
    </footer>
