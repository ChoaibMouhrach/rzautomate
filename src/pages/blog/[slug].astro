---
import type { GetStaticPaths } from "astro";
import { PostBody } from "@/components/pages/blog/[slug]/post-body";
import { PostCover } from "@/components/pages/blog/[slug]/post-cover";
import { PostCta } from "@/components/pages/blog/[slug]/post-cta";
import { PostHeader } from "@/components/pages/blog/[slug]/post-header";
import { PostJsonLd } from "@/components/pages/blog/[slug]/post-json-ld";
import { PostSidebar } from "@/components/pages/blog/[slug]/post-sidebar";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { posts } from "@/lib/blog";
import { pageSocial } from "@/lib/metadata";

export const getStaticPaths = (() =>
  posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))) satisfies GetStaticPaths;

const { post } = Astro.props;
const seo = pageSocial({
  title: post.title,
  description: post.excerpt,
  image: {
    url: `/blog/${post.slug}/opengraph-image.png`,
    alt: post.title,
  },
  authors: [post.author.name],
  article: {
    publishedTime: post.date,
    modifiedTime: post.updated ?? post.date,
  },
});
---

<SiteLayout {...seo}>
  <article class="page-container pb-24 pt-10 sm:pt-16">
    <PostJsonLd post={post} />
    <PostHeader post={post} />
    <PostCover post={post} />
    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <div>
        <PostBody client:load post={post} />
        <PostCta />
      </div>
      <PostSidebar client:load post={post} />
    </div>
  </article>
</SiteLayout>
