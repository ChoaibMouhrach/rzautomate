---
import { LeadGenerationContent } from "@/components/pages/services/ai-lead-generation/lead-generation-content";
import { path, seo } from "@/components/pages/services/ai-lead-generation/content";
import { authorName } from "@/components/pages/services/ai-lead-generation/json-ld";
import { ServicePosts } from "@/components/site/service-posts";
import { getPostsForService } from "@/lib/blog";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { pageSocial } from "@/lib/metadata";

const social = pageSocial({
  title: seo.title,
  description: seo.description,
  richSnippets: true,
  authors: [authorName],
  image: { url: `${path}/opengraph-image.png`, alt: seo.imageAlt },
  openGraphTitle: "AI Lead Generation & CRM Automation",
  openGraphDescription: seo.openGraphDescription,
  twitterTitle: "AI Lead Generation & CRM Automation",
  twitterDescription: seo.twitterDescription,
});
const posts = await getPostsForService("ai-lead-generation");
---

<SiteLayout {...social}>
  <LeadGenerationContent />
  <ServicePosts posts={posts} />
</SiteLayout>
